--- /dev/null
+++ b/functions/api/family-invites.ts
@@ -0,0 +1,77 @@
+// Numap API — GalakSay aile davetleri: liste + oluşturma.
+//   GET  /api/family-invites[?studentKey=<16hex>]  → { invites: [...] }
+//   POST /api/family-invites  { studentKey, label?, days? } → { invite, token, url }
+// RBAC: practitioner kendi davetleri; admin kurumunun; superadmin hepsi. Oluşturmak için
+// "galaksay" yetkisi ve öğrenciye erişim gerekir. Düz davet (token) YALNIZ oluşturma
+// yanıtında bir kez döner; sunucuda yalnız özeti tutulur (kaybolursa yenisi üretilir).
+
+import { json, fail, readJson, type Env } from '../_lib/http';
+import { getUser } from '../_lib/auth';
+import { audit, clientIp } from '../_lib/audit';
+import { userHasEntitlement } from '../_lib/entitlements';
+import {
+  ensureFamilyTable, newInviteToken, hashInviteToken, canAccessStudent, publicInvite,
+  INVITE_DAYS_DEFAULT, INVITE_DAYS_MAX, INVITES_PER_OWNER_MAX, type FamilyInviteRow,
+} from '../_lib/family';
+
+const GALAKSAY_FAMILY_URL = 'https://galaksay.com/aile#';
+
+export const onRequestGet: PagesFunction<Env> = async ({ request, env }) => {
+  const user = await getUser(request, env);
+  if (!user) return fail('Yetkisiz.', 401);
+  await ensureFamilyTable(env);
+  const sk = new URL(request.url).searchParams.get('studentKey');
+  if (sk !== null && !/^[a-f0-9]{16}$/.test(sk)) return fail('Geçersiz öğrenci anahtarı.', 422);
+  const where: string[] = [];
+  const binds: unknown[] = [];
+  if (user.role === 'admin' && user.institution_id) { where.push('(owner_id = ? OR institution_id = ?)'); binds.push(user.id, user.institution_id); }
+  else if (user.role !== 'superadmin') { where.push('owner_id = ?'); binds.push(user.id); }
+  if (sk) { where.push('student_key = ?'); binds.push(sk); }
+  const { results } = await env.DB.prepare(
+    `SELECT * FROM family_invites ${where.length ? `WHERE ${where.join(' AND ')}` : ''} ORDER BY created_at DESC LIMIT 500`,
+  ).bind(...binds).all<FamilyInviteRow>();
+  return json({ invites: results.map(publicInvite) });
+};
+
+export const onRequestPost: PagesFunction<Env> = async ({ request, env }) => {
+  const user = await getUser(request, env);
+  if (!user) return fail('Yetkisiz.', 401);
+  if (!(await userHasEntitlement(env, user, 'galaksay'))) return fail('GalakSay lisansı yok.', 403);
+  const body = await readJson<{ studentKey: string; label: string; days: number }>(request);
+  const studentKey = String(body.studentKey ?? '');
+  if (!/^[a-f0-9]{16}$/.test(studentKey)) return fail('Geçersiz öğrenci anahtarı.', 422);
+  const label = String(body.label ?? '').trim().slice(0, 80);
+  const daysRaw = Number(body.days ?? INVITE_DAYS_DEFAULT);
+  const days = Number.isFinite(daysRaw) ? Math.min(INVITE_DAYS_MAX, Math.max(1, Math.round(daysRaw))) : INVITE_DAYS_DEFAULT;
+
+  if (!(await canAccessStudent(env, user, studentKey))) return fail('Bu öğrenciye erişiminiz yok.', 403);
+  await ensureFamilyTable(env);
+  const active = await env.DB.prepare(
+    'SELECT COUNT(*) AS n FROM family_invites WHERE owner_id = ? AND revoked_at IS NULL AND expires_at > ?',
+  ).bind(user.id, new Date().toISOString()).first<{ n: number }>();
+  if ((active?.n ?? 0) >= INVITES_PER_OWNER_MAX) return fail('Etkin davet sınırına ulaşıldı. Kullanılmayanları iptal edin.', 409);
+
+  const token = newInviteToken();
+  const now = new Date();
+  const row: FamilyInviteRow = {
+    id: crypto.randomUUID(),
+    token_hash: await hashInviteToken(token),
+    owner_id: user.id,
+    institution_id: user.institution_id,
+    student_key: studentKey,
+    label,
+    created_at: now.toISOString(),
+    expires_at: new Date(now.getTime() + days * 86400_000).toISOString(),
+    revoked_at: null,
+    last_used_at: null,
+  };
+  await env.DB.prepare(
+    `INSERT INTO family_invites (id, token_hash, owner_id, institution_id, student_key, label, created_at, expires_at)
+     VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
+  ).bind(row.id, row.token_hash, row.owner_id, row.institution_id, row.student_key, row.label, row.created_at, row.expires_at).run();
+  await audit(env, {
+    actorId: user.id, actorRole: user.role, action: 'family_invite.create',
+    targetType: 'family_invite', targetId: row.id, ip: clientIp(request), meta: { studentKey, days },
+  });
+  return json({ invite: publicInvite(row), token, url: `${GALAKSAY_FAMILY_URL}${token}` }, 201);
+};
diff --git a/functions/api/family-invites/[id].ts b/functions/api/family-invites/[id].ts
new file mode 100644
