+const day = 24 * 3600 * 1000;
+const now = new Date('2026-09-28T12:00:00Z');
+const at = (daysAgo: number) => ({ startTime: new Date(now.getTime() - daysAgo * day).toISOString() });
+
+describe('galaksayDose', () => {
+  it('oturum yoksa doz sıfır, yeniden tarama yok', () => {
+    const d = galaksayDose([], null, now);
+    expect(d).toMatchObject({ sessions: 0, weeks: null, rescreenDue: false, reason: null });
+  });
+
+  it('yalnız son taramadan sonraki oturumları sayar', () => {
+    const d = galaksayDose([at(30), at(20), at(5)], new Date(now.getTime() - 25 * day).toISOString(), now);
+    expect(d.sessions).toBe(2);
+    expect(d.weeks).toBe(2);
+  });
+
+  it('42 oturumda doz tamam → yeniden tarama', () => {
+    const list = Array.from({ length: DOSE_TARGET_SESSIONS }, (_, i) => at(i));
+    const d = galaksayDose(list, null, now);
+    expect(d.rescreenDue).toBe(true);
+    expect(d.reason).toBe('dose');
+  });
+
+  it('13 hafta ve en az 10 oturum → süre ölçütüyle yeniden tarama', () => {
+    const list = Array.from({ length: 12 }, (_, i) => at(95 - i * 7));
+    const d = galaksayDose(list, null, now);
+    expect(d.rescreenDue).toBe(true);
+    expect(d.reason).toBe('time');
+  });
+
+  it('13 hafta ama az oturum → henüz değil', () => {
+    const d = galaksayDose([at(100), at(50)], null, now);
+    expect(d.rescreenDue).toBe(false);
+  });
+});
+
+describe('galaksayFocusAreas', () => {
+  it('rapor kategorilerini alan anahtarlarına çevirir, bilinmeyeni atar', () => {
+    expect(galaksayFocusAreas(['parent.cat.numberSense', 'parent.cat.calculation', 'parent.cat.xyz', 'parent.cat.numberSense']))
+      .toEqual(['numberSense', 'calculation']);
+    expect(galaksayFocusAreas(undefined)).toEqual([]);
+  });
+});
