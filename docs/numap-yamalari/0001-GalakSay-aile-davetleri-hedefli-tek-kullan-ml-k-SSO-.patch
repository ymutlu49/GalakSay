diff --git a/functions/_lib/family.ts b/functions/_lib/family.ts
new file mode 100644
index 0000000..8a5b5e8
--- /dev/null
+++ b/functions/_lib/family.ts
@@ -0,0 +1,152 @@
+// Numap API — GalakSay aile davetleri (kurum/öğretmen lisansı altında evde oynama).
+//
+// Lisanslı öğretmen, taradığı bir öğrenci için aileye bağlantı üretir:
+//   https://galaksay.com/aile#<davet>
+// GalakSay sunucusu daveti /api/family-invites/verify ile doğrular ve cihaza lisans çerezi
+// verir; ailenin çocuğu evde oynar, ilerleme /api/family-invites/game-progress ile
+// öğretmenin sahipliğinde o öğrenciye yazılır. Aile NuMap hesabı açmaz, NuMap'e giremez.
+//
+// Güvenlik: davet 32 bayt rastgele; sunucuda yalnız SHA-256 özeti tutulur. Süre (varsayılan
+// 180 gün), iptal ve sahibin lisansı her doğrulamada denetlenir: öğretmenin ya da kurumun
+// GalakSay yetkisi kalkarsa bütün davetleri kendiliğinden geçersizleşir.
+//
+// Tablo ilk kullanımda oluşturulur (ayrı göç adımı gerekmez); tanım db/migrations/0013'te de var.
+
+import type { Env } from './http';
+import type { DbUser } from './auth';
+import { canAccessSession } from './auth';
+import { userHasEntitlement } from './entitlements';
+
+export const INVITE_DAYS_DEFAULT = 180;
+export const INVITE_DAYS_MAX = 365;
+export const INVITES_PER_OWNER_MAX = 300;
+
+export interface FamilyInviteRow {
+  id: string;
+  token_hash: string;
+  owner_id: string;
+  institution_id: string | null;
+  student_key: string;
+  label: string;
+  created_at: string;
+  expires_at: string;
+  revoked_at: string | null;
+  last_used_at: string | null;
+}
+
+let ready = false;
+export async function ensureFamilyTable(env: Env): Promise<void> {
+  if (ready) return;
+  await env.DB.batch([
+    env.DB.prepare(
+      `CREATE TABLE IF NOT EXISTS family_invites (
+         id TEXT PRIMARY KEY,
+         token_hash TEXT NOT NULL UNIQUE,
+         owner_id TEXT NOT NULL,
+         institution_id TEXT,
+         student_key TEXT NOT NULL,
+         label TEXT NOT NULL DEFAULT '',
+         created_at TEXT NOT NULL,
+         expires_at TEXT NOT NULL,
+         revoked_at TEXT,
+         last_used_at TEXT
+       )`,
+    ),
+    env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_family_invites_owner ON family_invites(owner_id)'),
+    env.DB.prepare('CREATE INDEX IF NOT EXISTS idx_family_invites_student ON family_invites(student_key)'),
+  ]);
+  ready = true;
+}
+
+function b64url(bytes: Uint8Array): string {
+  let s = '';
+  for (const b of bytes) s += String.fromCharCode(b);
+  return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
+}
+
+export function newInviteToken(): string {
+  return `ad_${b64url(crypto.getRandomValues(new Uint8Array(32)))}`;
+}
+
+export async function hashInviteToken(token: string): Promise<string> {
+  const d = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(token) as BufferSource);
+  return [...new Uint8Array(d)].map((b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+export function isInviteTokenShape(v: unknown): v is string {
+  return typeof v === 'string' && /^ad_[A-Za-z0-9_-]{40,50}$/.test(v);
+}
+
+/** Kullanıcı bu öğrenciye erişebiliyor mu? (tarama oturumu, sınıf listesi ya da yörünge kaydı) */
+export async function canAccessStudent(env: Env, user: DbUser, studentKey: string): Promise<boolean> {
+  const owners: Array<{ owner_id: string; institution_id: string | null }> = [];
+  const q = async (sql: string) => {
+    const { results } = await env.DB.prepare(sql).bind(studentKey).all<{ owner_id: string; institution_id: string | null }>();
+    owners.push(...results);
+  };
+  await q('SELECT owner_id, institution_id FROM sessions WHERE student_key = ? AND deleted_at IS NULL LIMIT 50');
+  if (!owners.some((o) => canAccessSession(user, o.owner_id, o.institution_id))) {
+    try {
+      await q(
+        `SELECT l.owner_id AS owner_id, l.institution_id AS institution_id
+         FROM roster_students r JOIN class_lists l ON l.id = r.list_id WHERE r.student_key = ? LIMIT 50`,
+      );
+    } catch { /* tablo yoksa atla */ }
+    try {
+      await q('SELECT owner_id, institution_id FROM trajectory_assessments WHERE student_key = ? LIMIT 50');
+    } catch { /* tablo yoksa atla */ }
+  }
+  return owners.some((o) => canAccessSession(user, o.owner_id, o.institution_id));
+}
+
+export interface ActiveInvite {
+  invite: FamilyInviteRow;
+  owner: DbUser;
+}
+
+/**
+ * Daveti doğrular: biçim, kayıt, iptal, süre, sahibin etkinliği ve GalakSay lisansı.
+ * Geçerliyse davet + sahip; değilse null (neden ayrımı dışarı sızdırılmaz).
+ */
+export async function resolveInvite(env: Env, token: unknown): Promise<ActiveInvite | null> {
+  if (!isInviteTokenShape(token)) return null;
+  await ensureFamilyTable(env);
+  const invite = await env.DB.prepare('SELECT * FROM family_invites WHERE token_hash = ?')
+    .bind(await hashInviteToken(token))
+    .first<FamilyInviteRow>();
+  if (!invite || invite.revoked_at) return null;
+  if (Date.parse(invite.expires_at) <= Date.now()) return null;
+  const owner = await env.DB.prepare('SELECT * FROM users WHERE id = ? AND active = 1')
+    .bind(invite.owner_id)
+    .first<DbUser>();
+  if (!owner) return null;
+  if (!(await userHasEntitlement(env, owner, 'galaksay'))) return null;
+  return { invite, owner };
+}
+
+/** Son kullanım zamanını en çok saatte bir günceller (yazım yükü düşük kalır). */
+export async function touchInvite(env: Env, invite: FamilyInviteRow): Promise<void> {
+  const last = invite.last_used_at ? Date.parse(invite.last_used_at) : 0;
+  if (Date.now() - last < 3600_000) return;
+  try {
+    await env.DB.prepare('UPDATE family_invites SET last_used_at = ? WHERE id = ?')
+      .bind(new Date().toISOString(), invite.id)
+      .run();
+  } catch { /* best-effort */ }
+}
+
+/** Listeleme/yanıt için güvenli görünüm (özet ve sahiplik alanları yok). */
+export function publicInvite(r: FamilyInviteRow) {
+  const now = Date.now();
+  const status = r.revoked_at ? 'revoked' : Date.parse(r.expires_at) <= now ? 'expired' : 'active';
+  return {
+    id: r.id,
+    studentKey: r.student_key,
+    label: r.label,
+    createdAt: r.created_at,
+    expiresAt: r.expires_at,
+    revokedAt: r.revoked_at,
+    lastUsedAt: r.last_used_at,
+    status,
+  };
+}
diff --git a/functions/_lib/game-ingest.ts b/functions/_lib/game-ingest.ts
new file mode 100644
index 0000000..7c67b22
--- /dev/null
+++ b/functions/_lib/game-ingest.ts
@@ -0,0 +1,163 @@
+// Numap API — Galaksay oyun verisinin merkezi havuza yazımı (ortak çekirdek).
+// /api/game-progress (öğretmen Bearer) ve /api/family-invites/game-progress (aile daveti)
+// aynı çekirdeği kullanır. Sahiplik (owner_id/institution_id) ÇAĞIRANDAN gelir, gövdeden
+// alınmaz. forceStudentKey verilirse (aile daveti bir öğrenciye bağlı) bütün satırlar o
+// öğrenciye yazılır: childId "numap_<key>" olur.
+
+import type { Env } from './http';
+
+const BLOB_LIMIT = 240 * 1024; // tek events_json üst sınırı
+const CHUNK = 50; // D1 batch ifade sınırı (emniyetli)
+
+export interface GameBody {
+  sessions?: unknown;
+  events?: unknown;
+  ltTransitions?: unknown;
+  dailySummaries?: unknown;
+}
+
+export type GameAccepted = {
+  sessions: number;
+  events: number;
+  ltTransitions: number;
+  dailySummaries: number;
+};
+
+/** childId "numap_<16hex>" → student_key; uymuyorsa null (longitudinal bağ kopuk). */
+export function deriveStudentKey(childId: unknown): string | null {
+  if (typeof childId !== 'string') return null;
+  const m = /^numap_([a-f0-9]{16})$/.exec(childId);
+  return m ? m[1] : null;
+}
+
+const num = (v: unknown): number => (Number.isFinite(Number(v)) ? Number(v) : 0);
+const numOrNull = (v: unknown): number | null => (v == null || v === '' || !Number.isFinite(Number(v)) ? null : Number(v));
+const strOrNull = (v: unknown): string | null => (typeof v === 'string' && v.length ? v : null);
+
+/** Gövdedeki childId'leri öğrenciye sabitler (aile daveti). */
+function pin<T>(list: unknown, childId: string | null): T[] {
+  const arr = Array.isArray(list) ? (list as Array<Record<string, unknown>>) : [];
+  return (childId ? arr.map((x) => (x && typeof x === 'object' ? { ...x, childId } : x)) : arr) as T[];
+}
+
+export async function ingestGameProgress(
+  env: Env,
+  raw: GameBody,
+  owner: { ownerId: string; institutionId: string | null; forceStudentKey?: string | null },
+): Promise<GameAccepted> {
+  const forced = owner.forceStudentKey && /^[a-f0-9]{16}$/.test(owner.forceStudentKey) ? `numap_${owner.forceStudentKey}` : null;
+  const body: GameBody = {
+    sessions: pin(raw.sessions, forced),
+    events: pin(raw.events, forced),
+    ltTransitions: pin(raw.ltTransitions, forced),
+    dailySummaries: pin(raw.dailySummaries, forced),
+  };
+  const oid = owner.ownerId;
+  const iid = owner.institutionId;
+  const now = new Date().toISOString();
+  const stmts: D1PreparedStatement[] = [];
+  const accepted = { sessions: 0, events: 0, ltTransitions: 0, dailySummaries: 0 };
+
+  // ── game_sessions (özet) ──
+  const sessions = Array.isArray(body.sessions) ? body.sessions : [];
+  for (const s of sessions as Array<Record<string, unknown>>) {
+    if (typeof s?.sessionId !== 'string' || typeof s?.childId !== 'string') continue;
+    stmts.push(env.DB.prepare(
+      `INSERT INTO game_sessions
+         (session_id, child_id, student_key, owner_id, institution_id, start_time, end_time,
+          duration_ms, questions_attempted, questions_correct, categories_visited, device_type, app_version, synced_at)
+       VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)
+       ON CONFLICT(session_id) DO UPDATE SET
+         end_time=excluded.end_time, duration_ms=excluded.duration_ms,
+         questions_attempted=excluded.questions_attempted, questions_correct=excluded.questions_correct,
+         categories_visited=excluded.categories_visited, synced_at=excluded.synced_at`,
+    ).bind(
+      s.sessionId, s.childId, deriveStudentKey(s.childId), oid, iid,
+      String(s.startTime ?? now), strOrNull(s.endTime), num(s.durationMs),
+      num(s.questionsAttempted), num(s.questionsCorrect),
+      JSON.stringify(Array.isArray(s.categoriesVisited) ? s.categoriesVisited : []),
+      strOrNull(s.deviceType), strOrNull(s.appVersion), now,
+    ));
+    accepted.sessions++;
+  }
+
+  // ── game_events_blob (madde-düzey, oturum×kategori) ──
+  const events = Array.isArray(body.events) ? body.events : [];
+  for (const e of events as Array<Record<string, unknown>>) {
+    if (typeof e?.sessionId !== 'string' || typeof e?.category !== 'string' || !Array.isArray(e.items)) continue;
+    const items = e.items as Array<Record<string, unknown>>;
+    const blob = JSON.stringify(items);
+    if (blob.length > BLOB_LIMIT) continue; // aşırı büyük blob atla
+    const ts = items.map((it) => num(it?.timestamp)).filter((x) => x > 0);
+    stmts.push(env.DB.prepare(
+      `INSERT INTO game_events_blob
+         (session_id, category, child_id, student_key, owner_id, institution_id,
+          event_count, first_ts, last_ts, events_json, synced_at)
+       VALUES (?,?,?,?,?,?,?,?,?,?,?)
+       ON CONFLICT(session_id, category) DO UPDATE SET
+         event_count=excluded.event_count, first_ts=excluded.first_ts, last_ts=excluded.last_ts,
+         events_json=excluded.events_json, synced_at=excluded.synced_at
+       WHERE excluded.event_count >= game_events_blob.event_count`,
+    ).bind(
+      e.sessionId, e.category, strOrNull(e.childId) ?? '', deriveStudentKey(e.childId), oid, iid,
+      items.length, ts.length ? Math.min(...ts) : null, ts.length ? Math.max(...ts) : null, blob, now,
+    ));
+    accepted.events++;
+  }
+
+  // ── lt_transitions (seviye geçişi — değişmez, ilk yazım kalır) ──
+  const lts = Array.isArray(body.ltTransitions) ? body.ltTransitions : [];
+  for (const t of lts as Array<Record<string, unknown>>) {
+    if (typeof t?.childId !== 'string' || typeof t?.category !== 'string') continue;
+    const occurredAt = String(t.occurredAt ?? now);
+    const uid = `${t.childId}|${t.category}|${occurredAt}`;
+    stmts.push(env.DB.prepare(
+      `INSERT INTO lt_transitions
+         (transition_uid, child_id, student_key, owner_id, institution_id, category,
+          from_level, to_level, direction, criteria_snapshot, occurred_at, synced_at)
+       VALUES (?,?,?,?,?,?,?,?,?,?,?,?)
+       ON CONFLICT(transition_uid) DO NOTHING`,
+    ).bind(
+      uid, t.childId, deriveStudentKey(t.childId), oid, iid, t.category,
+      num(t.fromLevel), num(t.toLevel), t.direction === 'down' ? 'down' : 'up',
+      t.criteriaSnapshot != null ? JSON.stringify(t.criteriaSnapshot) : null, occurredAt, now,
+    ));
+    accepted.ltTransitions++;
+  }
+
+  // ── game_daily_summary (gün içinde değişir — son gelen kazanır) ──
+  const dailies = Array.isArray(body.dailySummaries) ? body.dailySummaries : [];
+  for (const d of dailies as Array<Record<string, unknown>>) {
+    if (typeof d?.childId !== 'string' || typeof d?.date !== 'string' || typeof d?.category !== 'string') continue;
+    const uid = `${d.childId}|${d.date}|${d.category}`;
+    stmts.push(env.DB.prepare(
+      `INSERT INTO game_daily_summary
+         (summary_uid, child_id, student_key, owner_id, institution_id, date, category,
+          questions_attempted, questions_correct, accuracy, avg_response_time_ms, avg_hint_level,
+          hint_dependency_rate, concrete_support_rate, lt_level, session_count, synced_at)
+       VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
+       ON CONFLICT(summary_uid) DO UPDATE SET
+         questions_attempted=excluded.questions_attempted, questions_correct=excluded.questions_correct,
+         accuracy=excluded.accuracy, avg_response_time_ms=excluded.avg_response_time_ms,
+         avg_hint_level=excluded.avg_hint_level, hint_dependency_rate=excluded.hint_dependency_rate,
+         concrete_support_rate=excluded.concrete_support_rate, lt_level=excluded.lt_level,
+         session_count=excluded.session_count, synced_at=excluded.synced_at`,
+    ).bind(
+      uid, d.childId, deriveStudentKey(d.childId), oid, iid, d.date, d.category,
+      num(d.questionsAttempted), num(d.questionsCorrect), numOrNull(d.accuracy),
+      numOrNull(d.avgResponseTimeMs), numOrNull(d.avgHintLevel), numOrNull(d.hintDependencyRate),
+      numOrNull(d.concreteSupportRate), numOrNull(d.ltLevel), num(d.sessionCount), now,
+    ));
+    accepted.dailySummaries++;
+  }
+
+  if (stmts.length === 0) return accepted;
+
+  // D1 batch ifade sınırı → CHUNK'lara böl (idempotent olduğu için güvenli).
+  for (let i = 0; i < stmts.length; i += CHUNK) {
+    await env.DB.batch(stmts.slice(i, i + CHUNK));
+  }
+
+
+  return accepted;
+}
