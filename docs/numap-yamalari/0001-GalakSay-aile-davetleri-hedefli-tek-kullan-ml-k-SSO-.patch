diff --git a/src/features/game-progress/family-invites-api.ts b/src/features/game-progress/family-invites-api.ts
new file mode 100644
index 0000000..d594421
--- /dev/null
+++ b/src/features/game-progress/family-invites-api.ts
@@ -0,0 +1,55 @@
+// Numap — GalakSay aile davetleri API istemcisi + React Query hook'ları.
+// Backend: functions/api/family-invites.ts, functions/api/family-invites/[id].ts
+
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { api } from '@/lib/api';
+
+export interface FamilyInvite {
+  id: string;
+  studentKey: string;
+  label: string;
+  createdAt: string;
+  expiresAt: string;
+  revokedAt: string | null;
+  lastUsedAt: string | null;
+  status: 'active' | 'revoked' | 'expired';
+}
+
+export interface CreatedFamilyInvite {
+  invite: FamilyInvite;
+  /** Düz davet yalnız oluşturma yanıtında bir kez gelir. */
+  token: string;
+  url: string;
+}
+
+export const familyInvitesApi = {
+  list: (studentKey: string) =>
+    api.get<{ invites: FamilyInvite[] }>(`/family-invites?studentKey=${encodeURIComponent(studentKey)}`).then((r) => r.invites ?? []),
+  create: (body: { studentKey: string; label?: string; days?: number }) => api.post<CreatedFamilyInvite>('/family-invites', body),
+  revoke: (id: string) => api.del<{ invite: FamilyInvite }>(`/family-invites/${encodeURIComponent(id)}`),
+};
+
+export function useFamilyInvites(studentKey: string | null, enabled = true) {
+  return useQuery({
+    queryKey: ['familyInvites', studentKey],
+    queryFn: () => familyInvitesApi.list(studentKey as string),
+    enabled: Boolean(studentKey) && enabled,
+    staleTime: 30_000,
+  });
+}
+
+export function useCreateFamilyInvite(studentKey: string) {
+  const qc = useQueryClient();
+  return useMutation({
+    mutationFn: (v: { label?: string; days?: number }) => familyInvitesApi.create({ studentKey, ...v }),
+    onSuccess: () => { void qc.invalidateQueries({ queryKey: ['familyInvites', studentKey] }); },
+  });
+}
+
+export function useRevokeFamilyInvite(studentKey: string) {
+  const qc = useQueryClient();
+  return useMutation({
+    mutationFn: (id: string) => familyInvitesApi.revoke(id),
+    onSuccess: () => { void qc.invalidateQueries({ queryKey: ['familyInvites', studentKey] }); },
+  });
+}
