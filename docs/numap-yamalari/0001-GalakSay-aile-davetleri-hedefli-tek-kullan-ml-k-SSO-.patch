+// Numap — Öğrenci sayfasında GalakSay köprüsü: önerilen rota, müdahale dozu ve yeniden
+// tarama hatırlatması, GalakSay'ı bu öğrenciyle açma ve aile davetleri.
+// Tarama (NuMap) → müdahale (GalakSay, okulda ve evde) → yeniden tarama döngüsünü tek
+// kartta gösterir. Aile daveti yalnız "galaksay" yetkisi olan kullanıcıya görünür.
+
+import { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Button } from '@/components/Button';
+import { openAppWithSso, APP_URLS } from '@/lib/sso';
+import { galaksayDose, galaksayFocusAreas } from './galaksay-dose';
+import { useCreateFamilyInvite, useFamilyInvites, useRevokeFamilyInvite, type CreatedFamilyInvite } from './family-invites-api';
+
+interface Props {
+  studentKey: string;
+  gameSessions: ReadonlyArray<{ startTime: string }>;
+  lastScreeningAt: string | null;
+  concernCategories: readonly string[] | undefined;
+  canUseGalaksay: boolean;
+  onStartScreening: () => void;
+}
+
+const DAY_CHOICES = [30, 90, 180, 365] as const;
+
+export function GalaksayStudentPanel({ studentKey, gameSessions, lastScreeningAt, concernCategories, canUseGalaksay, onStartScreening }: Props) {
+  const { t, i18n } = useTranslation();
+  const dose = galaksayDose(gameSessions, lastScreeningAt);
+  const areas = galaksayFocusAreas(concernCategories);
+  const fmt = (iso: string) => new Date(iso).toLocaleDateString(i18n.language === 'tr' ? 'tr-TR' : 'en-US', { dateStyle: 'medium' });
+  const pctDose = Math.min(100, Math.round((dose.sessions / dose.target) * 100));
+
+  return (
+    <div className="mt-3 space-y-4 border-t border-card-border pt-3 text-sm" data-testid="hub-galaksay-panel">
+      {/* Önerilen rota */}
+      <div>
+        <p className="text-xs font-semibold uppercase tracking-wide text-subtle">{t('galaksayPanel.routeTitle')}</p>
+        {areas.length > 0 ? (
+          <ul className="mt-1 list-disc space-y-0.5 pl-5 text-foreground">
+            {areas.map((a) => <li key={a}>{t(`report.galaksayArea.${a}`)}</li>)}
+          </ul>
+        ) : (
+          <p className="mt-1 text-muted-foreground">{lastScreeningAt ? t('galaksayPanel.routeNone') : t('galaksayPanel.routeNeedsScreening')}</p>
+        )}
+      </div>
+
+      {/* Doz ve yeniden tarama */}
+      <div>
+        <p className="text-xs font-semibold uppercase tracking-wide text-subtle">{t('galaksayPanel.doseTitle')}</p>
+        <div className="mt-1 flex items-center gap-3">
+          <div className="h-2 flex-1 overflow-hidden rounded-full bg-muted" role="progressbar" aria-valuemin={0} aria-valuemax={dose.target} aria-valuenow={dose.sessions}>
+            <div className={`h-full rounded-full ${dose.rescreenDue ? 'bg-success' : 'bg-primary'}`} style={{ width: `${pctDose}%` }} />
+          </div>
+          <span className="shrink-0 tabular-nums text-foreground">{t('galaksayPanel.doseCount', { n: dose.sessions, target: dose.target })}</span>
+        </div>
+        <p className="mt-1 text-xs text-muted-foreground">
+          {dose.weeks != null ? t('galaksayPanel.doseWeeks', { weeks: dose.weeks, perWeek: dose.perWeek }) : t('galaksayPanel.doseNone')}
+        </p>
+        {dose.rescreenDue && (
+          <div className="mt-2 flex flex-wrap items-center gap-2 rounded-xl bg-warning/10 px-3 py-2" data-testid="hub-galaksay-rescreen">
+            <span className="font-medium text-warning">{t(dose.reason === 'dose' ? 'galaksayPanel.rescreenDose' : 'galaksayPanel.rescreenTime')}</span>
+            <Button size="sm" variant="secondary" onClick={onStartScreening}>{t('galaksayPanel.rescreenStart')}</Button>
+          </div>
+        )}
+      </div>
+
+      {canUseGalaksay && (
+        <>
+          <div>
+            <Button size="sm" variant="secondary" onClick={() => void openAppWithSso(APP_URLS.galaksay, { app: 'galaksay', params: { ogrenci: studentKey } })}>
+              {t('galaksayPanel.openWithStudent')}
+            </Button>
+          </div>
+          <FamilyInvites studentKey={studentKey} fmt={fmt} />
+        </>
+      )}
+    </div>
+  );
+}
+
+function FamilyInvites({ studentKey, fmt }: { studentKey: string; fmt: (iso: string) => string }) {
+  const { t } = useTranslation();
+  const { data: invites = [], isLoading } = useFamilyInvites(studentKey);
+  const create = useCreateFamilyInvite(studentKey);
+  const revoke = useRevokeFamilyInvite(studentKey);
+  const [open, setOpen] = useState(false);
+  const [label, setLabel] = useState('');
+  const [days, setDays] = useState<number>(180);
+  const [created, setCreated] = useState<CreatedFamilyInvite | null>(null);
+  const [copied, setCopied] = useState(false);
+  const active = invites.filter((i) => i.status === 'active');
+
+  const submit = () => {
+    create.mutate({ label: label.trim() || undefined, days }, {
+      onSuccess: (r) => { setCreated(r); setOpen(false); setLabel(''); setCopied(false); },
+    });
+  };
+  const copy = async (url: string) => {
+    try { await navigator.clipboard.writeText(url); setCopied(true); } catch { setCopied(false); }
+  };
+
+  return (
+    <div data-testid="hub-family-invites">
+      <div className="flex items-center justify-between gap-2">
+        <p className="text-xs font-semibold uppercase tracking-wide text-subtle">{t('galaksayPanel.familyTitle')}</p>
+        {!open && <Button size="sm" variant="outline" onClick={() => { setOpen(true); setCreated(null); }}>{t('galaksayPanel.familyNew')}</Button>}
+      </div>
+      <p className="mt-1 text-xs text-muted-foreground">{t('galaksayPanel.familyIntro')}</p>
+
+      {open && (
+        <div className="mt-2 grid gap-2 rounded-xl border border-card-border p-3">
+          <label className="grid gap-1 text-xs text-muted-foreground">
+            {t('galaksayPanel.familyLabel')}
+            <input value={label} maxLength={80} onChange={(e) => setLabel(e.target.value)} placeholder={t('galaksayPanel.familyLabelPh')}
+              className="rounded-lg border border-card-border bg-card px-3 py-2 text-sm text-foreground outline-none focus:border-primary" />
+          </label>
+          <label className="grid gap-1 text-xs text-muted-foreground">
+            {t('galaksayPanel.familyDays')}
+            <select value={days} onChange={(e) => setDays(Number(e.target.value))}
+              className="rounded-lg border border-card-border bg-card px-3 py-2 text-sm text-foreground">
+              {DAY_CHOICES.map((d) => <option key={d} value={d}>{t('galaksayPanel.familyDaysOpt', { count: d })}</option>)}
+            </select>
+          </label>
+          {create.isError && <p className="text-xs text-error">{(create.error as Error)?.message || t('galaksayPanel.familyError')}</p>}
+          <div className="flex gap-2">
+            <Button size="sm" onClick={submit} disabled={create.isPending}>{t('galaksayPanel.familyCreate')}</Button>
+            <Button size="sm" variant="ghost" onClick={() => setOpen(false)}>{t('galaksayPanel.cancel')}</Button>
+          </div>
+        </div>
+      )}
+
+      {created && (
+        <div className="mt-2 grid gap-2 rounded-xl bg-success/10 p-3" data-testid="hub-family-created">
+          <p className="text-xs font-medium text-foreground">{t('galaksayPanel.familyCreated')}</p>
+          <input readOnly value={created.url} onFocus={(e) => e.currentTarget.select()}
+            className="w-full rounded-lg border border-card-border bg-card px-3 py-2 font-mono text-xs text-foreground" />
+          <div className="flex items-center gap-2">
+            <Button size="sm" variant="secondary" onClick={() => void copy(created.url)}>{copied ? t('galaksayPanel.copied') : t('galaksayPanel.copy')}</Button>
+            <span className="text-xs text-muted-foreground">{t('galaksayPanel.familyOnce')}</span>
+          </div>
+        </div>
+      )}
+
+      {!isLoading && active.length > 0 && (
+        <ul className="mt-2 divide-y divide-card-border/60">
+          {active.map((i) => (
+            <li key={i.id} className="flex items-center justify-between gap-2 py-1.5">
+              <span className="min-w-0 truncate text-foreground">
+                {i.label || t('galaksayPanel.familyUnnamed')}
+                <span className="ml-2 text-xs text-subtle">
+                  {t('galaksayPanel.familyUntil', { date: fmt(i.expiresAt) })}
+                  {i.lastUsedAt ? ` · ${t('galaksayPanel.familyUsed', { date: fmt(i.lastUsedAt) })}` : ` · ${t('galaksayPanel.familyNotUsed')}`}
+                </span>
+              </span>
+              <Button size="sm" variant="ghost" disabled={revoke.isPending} onClick={() => revoke.mutate(i.id)}>{t('galaksayPanel.familyRevoke')}</Button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
