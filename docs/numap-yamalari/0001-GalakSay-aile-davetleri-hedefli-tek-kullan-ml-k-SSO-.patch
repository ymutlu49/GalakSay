+// Numap API — GalakSay aile davetini doğrula: POST /api/family-invites/verify { token }.
+// Çağıran GalakSay sunucusudur (lisans çerezi vermeden önce). Bearer gerekmez; güven
+// 256 bitlik rastgele davete dayanır. Başarısız denemeler IP başına sınırlanır.
+// Yanıt kişisel veri içermez: çocuğun adı yok, yalnız öğretmenin verdiği etiket.
+
+import { json, fail, readJson, type Env } from '../../_lib/http';
+import { audit } from '../../_lib/audit';
+import { checkLimit, recordFailure, clientIp } from '../../_lib/ratelimit';
+import { resolveInvite, touchInvite } from '../../_lib/family';
+
+export const onRequestPost: PagesFunction<Env> = async ({ request, env, waitUntil }) => {
+  const ip = clientIp(request);
+  const key = `family|ip|${ip}`;
+  const lim = await checkLimit(env, key);
+  if (!lim.allowed) return fail('Çok fazla deneme. Biraz sonra yeniden deneyin.', 429);
+  const body = await readJson<{ token: string }>(request);
+  const active = await resolveInvite(env, body.token);
+  if (!active) {
+    await recordFailure(env, key);
+    return fail('Davet geçersiz, süresi dolmuş ya da iptal edilmiş.', 404);
+  }
+  const { invite, owner } = active;
+  waitUntil(touchInvite(env, invite));
+  let institutionName: string | null = null;
+  if (owner.institution_id) {
+    const inst = await env.DB.prepare('SELECT name FROM institutions WHERE id = ?').bind(owner.institution_id).first<{ name: string }>();
+    institutionName = inst?.name ?? null;
+  }
+  waitUntil(audit(env, {
+    actorId: owner.id, actorRole: 'family', action: 'family_invite.verify',
+    targetType: 'family_invite', targetId: invite.id, ip,
+  }));
+  return json({
+    ok: true,
+    inviteId: invite.id,
+    label: invite.label,
+    expiresAt: invite.expires_at,
+    teacherName: owner.name,
+    institutionName,
+  });
+};
