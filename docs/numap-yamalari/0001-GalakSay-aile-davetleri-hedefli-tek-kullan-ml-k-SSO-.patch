new file mode 100644
index 0000000..cb19597
--- /dev/null
+++ b/src/features/game-progress/galaksay-dose.ts
@@ -0,0 +1,55 @@
+// Numap — GalakSay müdahale dozu ve yeniden tarama zamanı (saf işlev).
+//
+// Ölçüt: Kohn ve ark. (2020) Calcularis çalışması — 42 oturum × ~20 dk, en çok 13 hafta.
+// Doz, SON taramadan sonra oynanan oturumlarla hesaplanır. Yeniden tarama önerilir:
+//   (a) hedef doza ulaşıldıysa (≥ 42 oturum), ya da
+//   (b) ilk oturumdan bu yana 13 hafta geçti ve en az 10 oturum oynandıysa (etkiyi ölçecek kadar veri).
+
+export const DOSE_TARGET_SESSIONS = 42;
+export const DOSE_MAX_WEEKS = 13;
+const MIN_SESSIONS_FOR_RESCREEN = 10;
+const WEEK_MS = 7 * 24 * 3600 * 1000;
+
+export interface GalaksayDose {
+  /** Son taramadan sonra oynanan oturum sayısı. */
+  readonly sessions: number;
+  readonly target: number;
+  /** İlk oturumdan (son taramadan sonraki) bu yana geçen hafta; oturum yoksa null. */
+  readonly weeks: number | null;
+  /** Haftalık ortalama oturum (en az 1 hafta üzerinden); oturum yoksa null. */
+  readonly perWeek: number | null;
+  readonly rescreenDue: boolean;
+  readonly reason: 'dose' | 'time' | null;
+}
+
+export function galaksayDose(
+  sessions: ReadonlyArray<{ startTime: string }>,
+  lastScreeningAt: string | null,
+  now: Date = new Date(),
+): GalaksayDose {
+  const since = lastScreeningAt ? Date.parse(lastScreeningAt) : Number.NEGATIVE_INFINITY;
+  const times = sessions
+    .map((s) => Date.parse(s.startTime))
+    .filter((t) => Number.isFinite(t) && t > since)
+    .sort((a, b) => a - b);
+  const n = times.length;
+  if (n === 0) return { sessions: 0, target: DOSE_TARGET_SESSIONS, weeks: null, perWeek: null, rescreenDue: false, reason: null };
+  const weeks = Math.max(0, (now.getTime() - times[0]) / WEEK_MS);
+  const perWeek = n / Math.max(1, weeks);
+  const byDose = n >= DOSE_TARGET_SESSIONS;
+  const byTime = weeks >= DOSE_MAX_WEEKS && n >= MIN_SESSIONS_FOR_RESCREEN;
+  return {
+    sessions: n,
+    target: DOSE_TARGET_SESSIONS,
+    weeks: Math.floor(weeks),
+    perWeek: Math.round(perWeek * 10) / 10,
+    rescreenDue: byDose || byTime,
+    reason: byDose ? 'dose' : byTime ? 'time' : null,
+  };
+}
+
+/** Rapor yorumundaki odak kategorileri ('parent.cat.<k>') → GalakSay alan anahtarları. */
+export function galaksayFocusAreas(concernCategories: readonly string[] | undefined): string[] {
+  const known = new Set(['numberSense', 'calculation', 'sequencing', 'memory', 'attention']);
+  return [...new Set((concernCategories ?? []).map((c) => c.replace('parent.cat.', '')).filter((k) => known.has(k)))];
+}
