--- /dev/null
+++ b/functions/api/family-invites/[id].ts
@@ -0,0 +1,26 @@
+// Numap API — GalakSay aile davetini iptal: DELETE /api/family-invites/<id>.
+// Sahibi, sahibin kurumunun yöneticisi ya da superadmin iptal edebilir. İptal kalıcıdır;
+// o davetle lisans çerezi alan cihaz bir sonraki doğrulamada (en geç 1 saat) düşer.
+
+import { json, fail, type Env } from '../../_lib/http';
+import { getUser, canAccessSession } from '../../_lib/auth';
+import { audit, clientIp } from '../../_lib/audit';
+import { ensureFamilyTable, publicInvite, type FamilyInviteRow } from '../../_lib/family';
+
+export const onRequestDelete: PagesFunction<Env> = async ({ request, env, params }) => {
+  const user = await getUser(request, env);
+  if (!user) return fail('Yetkisiz.', 401);
+  await ensureFamilyTable(env);
+  const id = String(params.id ?? '');
+  const row = await env.DB.prepare('SELECT * FROM family_invites WHERE id = ?').bind(id).first<FamilyInviteRow>();
+  if (!row || !canAccessSession(user, row.owner_id, row.institution_id)) return fail('Davet bulunamadı.', 404);
+  const at = row.revoked_at ?? new Date().toISOString();
+  if (!row.revoked_at) {
+    await env.DB.prepare('UPDATE family_invites SET revoked_at = ? WHERE id = ?').bind(at, id).run();
+    await audit(env, {
+      actorId: user.id, actorRole: user.role, action: 'family_invite.revoke',
+      targetType: 'family_invite', targetId: id, ip: clientIp(request),
+    });
+  }
+  return json({ invite: publicInvite({ ...row, revoked_at: at }) });
+};
diff --git a/functions/api/family-invites/game-progress.ts b/functions/api/family-invites/game-progress.ts
new file mode 100644
