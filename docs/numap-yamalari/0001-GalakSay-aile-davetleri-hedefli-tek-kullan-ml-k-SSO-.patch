@@ -0,0 +1,39 @@
+// Numap API — Aile cihazından GalakSay oyun ilerlemesi: POST /api/family-invites/game-progress.
+// Kimlik: X-Aile-Davet başlığındaki davet (GalakSay sunucusu HttpOnly çerezden aktarır).
+// Satırlar davetin sahibinin (öğretmen) sahipliğinde ve davetin öğrencisine yazılır:
+// gövdedeki childId ne olursa olsun "numap_<studentKey>" olur. Öğretmen bu ilerlemeyi
+// NuMap'teki öğrenci sayfasında kendi cihazındaki oyunlarla birlikte görür.
+
+import { json, fail, type Env } from '../../_lib/http';
+import { audit, clientIp } from '../../_lib/audit';
+import { ValidationError, readBoundedJson } from '../../_lib/validate';
+import { ingestGameProgress, type GameBody } from '../../_lib/game-ingest';
+import { resolveInvite, touchInvite } from '../../_lib/family';
+
+const BODY_LIMIT = 1024 * 1024;
+
+export const onRequestPost: PagesFunction<Env> = async ({ request, env, waitUntil }) => {
+  const active = await resolveInvite(env, request.headers.get('X-Aile-Davet'));
+  if (!active) return fail('Davet geçersiz.', 401);
+  const { invite, owner } = active;
+
+  let body: GameBody;
+  try {
+    body = await readBoundedJson<GameBody>(request, BODY_LIMIT);
+  } catch (e) {
+    if (e instanceof ValidationError) return fail(e.message, e.status);
+    return fail('Geçersiz istek.', 400);
+  }
+
+  const accepted = await ingestGameProgress(env, body, {
+    ownerId: owner.id,
+    institutionId: owner.institution_id,
+    forceStudentKey: invite.student_key,
+  });
+  waitUntil(touchInvite(env, invite));
+  waitUntil(audit(env, {
+    actorId: owner.id, actorRole: 'family', action: 'game.write',
+    targetType: 'family_invite', targetId: invite.id, ip: clientIp(request), meta: accepted,
+  }));
+  return json({ accepted });
+};
